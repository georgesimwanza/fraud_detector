# Shared secret the web server sends as X-Internal-Key. Must equal INFERENCE_INTERNAL_KEY in web/.env.local.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INFERENCE_INTERNAL_KEY=

# Folder holding model bundles (models/<version>/). Default: <repo>/models
# MODELS_DIR=../models

# Pin one bundle instead of the most recently trained one.
# MODEL_BUNDLE=../models/stub-20261025-120000

# Optional challenger. Scored alongside the active model on every request; its scores are stored
# and compared on the Model page but never raise an alert. Create a demo one with:
#   python training/make_stub_bundle.py --bias -4 --version stub-challenger --out models/shadow
# SHADOW_MODEL_BUNDLE=../models/shadow/stub-challenger
