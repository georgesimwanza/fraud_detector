# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (PostgreSQL) ----------------------------------------------------
# The app connects as its own role, never as the postgres superuser.
# One-off setup, as the superuser (psql -U postgres):
#   CREATE ROLE fraud_app LOGIN PASSWORD '<long random password>';
#   CREATE DATABASE fraud_detection OWNER fraud_app;
#   CREATE DATABASE fraud_detection_test OWNER fraud_app;   -- used only by `npm test`
DATABASE_URL=postgres://fraud_app:<password>@localhost:5432/fraud_detection
DATABASE_URL_TEST=postgres://fraud_app:<password>@localhost:5432/fraud_detection_test

# --- Sessions -----------------------------------------------------------------
# HMAC key for signing session JWTs (HS256). At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Ingest -------------------------------------------------------------------
# SHA-256 (hex) of the ingest API key the simulator sends as X-Api-Key. Only the hash lives here.
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Hash it:         node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" <key>
INGEST_API_KEY_SHA256=

# --- Inference service (server-to-server only, never exposed to the browser) ---
INFERENCE_URL=http://127.0.0.1:8000
# Must equal INFERENCE_INTERNAL_KEY in inference/.env
INFERENCE_INTERNAL_KEY=
